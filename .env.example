# Browser (safe to expose — anon key only)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_key

# Vercel serverless only (api/create-user.js) — NEVER commit the real service_role key
# Copy from Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias if you prefer not using REACT_APP_ in server code:
# SUPABASE_URL= same as REACT_APP_SUPABASE_URL
